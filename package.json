{
  "name": "campusflow-root",
  "private": true,
  "workspaces": [
    "Client",
    "Server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w Client",
    "server": "npm run dev -w server",
    "client": "npm run dev -w Client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "passport-jwt": "^4.0.1",
    "react-toastify": "^11.1.0"
  }
}
